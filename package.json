{
  "name": "personal-fitness-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Persönliche Fitness-App (PWA) fürs Training im Studio – lokal, offline, ohne Backend.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
